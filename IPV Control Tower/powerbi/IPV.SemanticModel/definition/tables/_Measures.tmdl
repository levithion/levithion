table _Measures

	measure Positions =
			COUNTROWS ( fact_ipv )
		formatString: #,##0
		displayFolder: Coverage

	measure 'Independently Verified' =
			CALCULATE ( [Positions], fact_ipv[n_quotes] > 0 )
		formatString: #,##0
		displayFolder: Coverage

	measure 'Coverage %' =
			DIVIDE ( [Independently Verified], [Positions] )
		formatString: 0.0%
		displayFolder: Coverage

	measure Exceptions =
			CALCULATE ( [Positions], fact_ipv[status] = "EXCEPTION" )
		formatString: #,##0
		displayFolder: Exceptions

	measure 'Critical Exceptions' =
			CALCULATE ( [Exceptions], fact_ipv[severity] = "CRITICAL" )
		formatString: #,##0
		displayFolder: Exceptions

	measure 'Exceptions Prior Month' =
			CALCULATE ( [Exceptions], REMOVEFILTERS ( dim_date ), dim_date[month_index] = MAX ( dim_date[month_index] ) - 1 )
		formatString: #,##0
		displayFolder: Exceptions

	measure 'Exceptions MoM Δ' =
			[Exceptions] - [Exceptions Prior Month]
		formatString: +#,##0;-#,##0;0
		displayFolder: Exceptions

	measure 'Proposed IPV Reserve' =
			// Positive reserve: revaluation of breached positions to consensus.
			- CALCULATE ( SUM ( fact_ipv[pv_adjustment_usd] ), fact_ipv[is_breach] = TRUE () )
		formatString: #,##0
		displayFolder: Valuation adjustments

	measure 'Proposed IPV Reserve Prior' =
			CALCULATE ( [Proposed IPV Reserve], REMOVEFILTERS ( dim_date ), dim_date[month_index] = MAX ( dim_date[month_index] ) - 1 )
		formatString: #,##0
		displayFolder: Valuation adjustments

	measure 'Net Mark-to-Consensus' =
			SUM ( fact_ipv[pv_adjustment_usd] )
		formatString: #,##0
		displayFolder: Valuation adjustments

	measure 'AVA MPU' =
			SUM ( fact_ipv[ava_mpu_usd] )
		formatString: #,##0
		displayFolder: Valuation adjustments

	measure 'AVA Close-out' =
			SUM ( fact_ipv[ava_coc_usd] )
		formatString: #,##0
		displayFolder: Valuation adjustments

	measure 'Aggregated AVA' =
			// EBA RTS core approach: 50% aggregation factor on MPU and close-out AVAs.
			0.5 * ( [AVA MPU] + [AVA Close-out] )
		formatString: #,##0
		displayFolder: Valuation adjustments

	measure 'Level 3 Positions' =
			CALCULATE ( [Positions], fact_ipv[derived_level] = 3 )
		formatString: #,##0
		displayFolder: Fair value hierarchy

	measure 'Level 3 %' =
			DIVIDE ( [Level 3 Positions], [Positions] )
		formatString: 0.0%
		displayFolder: Fair value hierarchy

	measure 'Level Downgrades' =
			SUMX ( fact_ipv, IF ( fact_ipv[derived_level] > RELATED ( dim_position[booked_level] ), 1 ) )
		formatString: #,##0
		displayFolder: Fair value hierarchy

	measure 'Level Upgrades' =
			SUMX ( fact_ipv, IF ( fact_ipv[derived_level] < RELATED ( dim_position[booked_level] ), 1 ) )
		formatString: #,##0
		displayFolder: Fair value hierarchy

	measure 'ML Review Queue' =
			CALCULATE ( [Positions], fact_ipv[anomaly_flag] = 1, fact_ipv[status] = "PASS" )
		formatString: #,##0
		displayFolder: Triage

	measure 'Open Workflow Items' =
			CALCULATE ( COUNTROWS ( fact_exception ), fact_exception[status] IN { "OPEN", "EXPLAINED" } )
		formatString: #,##0
		displayFolder: Triage

	measure 'Avg Exception Age (months)' =
			CALCULATE ( AVERAGE ( fact_exception[periods_open] ), fact_exception[status] IN { "OPEN", "EXPLAINED" } )
		formatString: 0.0
		displayFolder: Triage

	measure 'Reserve Label' =
			VAR v = [Proposed IPV Reserve]
			RETURN "USD " & FORMAT ( v / 1e6, "0.00" ) & "m"
		displayFolder: Formatting

	measure 'Latest Month Only' =
			// Visual-level filter (= 1) on pages that show a single month-end.
			IF ( MAX ( dim_date[is_latest] ), 1, 0 )
		formatString: 0
		displayFolder: Formatting

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table [Placeholder = text], {})
			in
				Source
